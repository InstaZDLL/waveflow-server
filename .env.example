# Copy this file to `.env` and fill in real values.
#
# `.env` is gitignored — never commit a populated file. The
# example values below are placeholders, not defaults.

# Postgres connection string consumed by Better Auth via Kysely +
# node-postgres. The dev convention is to point at the same local
# Postgres waveflow-server uses, on a separate database (e.g.
# `postgres://wf:wf@localhost:5432/waveflow_auth`) — Better Auth's
# tables (`user`, `session`, `account`, `verification`, `jwks`)
# coexist fine with waveflow-server's tables in the same instance,
# but a dedicated DB keeps the migration ownership cleaner.
DATABASE_URL=postgres://wf:wf@localhost:5432/waveflow_auth

# Max size of the in-process Postgres pool (defaults to 10 when unset).
# Bump if you deploy without a pgbouncer / RDS proxy in front.
# BETTER_AUTH_DB_MAX=10

# 32-byte random secret Better Auth uses to sign session cookies +
# JWTs. Generate with:
#   openssl rand -base64 32
# Rotating this invalidates every existing session.
BETTER_AUTH_SECRET=replace-me-with-openssl-rand-base64-32-output

# Public-facing origin of this Nitro instance. Better Auth uses it
# for the JWT `iss` claim and for OAuth redirect URLs. Must match
# the URL the browser hits (incl. scheme + port).
BETTER_AUTH_URL=http://localhost:3000

# Audience claim stamped into every JWT issued by the `jwt()` plugin.
# Defaults to `waveflow-server` so the verifier on the Rust side has
# a stable string to check `aud` against. Override when multiple
# backend instances share this auth server (e.g.
# `waveflow-server-eu` / `waveflow-server-us`).
# WAVEFLOW_JWT_AUDIENCE=waveflow-server
