# WaveFlow Server v2 local configuration.

# Directory containing waveflow.db, instance.key and future caches.
WAVEFLOW_DATA_DIR=./data

# Safe loopback default. Use 0.0.0.0:4533 behind a trusted reverse proxy.
WAVEFLOW_BIND=127.0.0.1:4533

# External origin used in Subsonic share URLs. Set this to the HTTPS origin
# exposed by your reverse proxy; omit it to return relative share URLs.
# WAVEFLOW_PUBLIC_URL=https://music.example.com

# Comma-separated exact browser origins allowed to call the API. Empty keeps
# cross-origin access disabled. Example for a local Feishin web container:
# WAVEFLOW_ALLOWED_ORIGINS=http://127.0.0.1:9180

# Ordinary JSON/API requests only. Streaming gets its own policy in M2.
WAVEFLOW_REQUEST_TIMEOUT_SECS=30

# SQLite reader pool. Writes are serialized by the process-wide writer gate.
WAVEFLOW_DB_MAX_CONNECTIONS=8
WAVEFLOW_SQLITE_BUSY_TIMEOUT_MS=5000

# Opaque local sessions. Refresh tokens rotate on every successful use.
WAVEFLOW_ACCESS_TOKEN_TTL_SECS=900
WAVEFLOW_REFRESH_TOKEN_TTL_SECS=2592000

# Scanner. Set interval to 0 to disable scheduled scans; boot/manual scans
# remain available. Extraction is parallel, SQLite writes stay serialized.
WAVEFLOW_SCAN_INTERVAL_SECS=21600
WAVEFLOW_SCAN_PARALLELISM=4

# FFmpeg and ffprobe are mandatory from M2 onward. Override these when the
# executables are not discoverable through PATH.
WAVEFLOW_FFMPEG_PATH=ffmpeg
WAVEFLOW_FFPROBE_PATH=ffprobe

# Completed transcodes are content-addressed and evicted least-recently-used.
WAVEFLOW_TRANSCODE_CACHE_MAX_BYTES=10737418240
WAVEFLOW_TRANSCODE_GLOBAL_LIMIT=4
WAVEFLOW_TRANSCODE_PER_USER_LIMIT=2

# CLI commands read passwords from an environment variable so secrets do not
# appear in shell history or process arguments. Do not persist real values here.
# WAVEFLOW_ACCOUNT_PASSWORD=
# WAVEFLOW_SUBSONIC_PASSWORD=

RUST_LOG=info,waveflow_server=debug,tower_http=info
# WAVEFLOW_LOG_FORMAT=json
