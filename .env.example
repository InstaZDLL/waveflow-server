# Copy this file to `.env` and fill in real values.
#
# `.env` is gitignored — never commit a populated file. The
# example values below are placeholders, not defaults.

# Postgres connection string consumed by Better Auth via Kysely +
# node-postgres. The dev convention is to point at the same local
# Postgres waveflow-server uses, on a separate database (e.g.
# `postgres://wf:wf@localhost:5432/waveflow_auth`) — Better Auth's
# tables (`user`, `session`, `account`, `verification`, `jwks`)
# coexist fine with waveflow-server's tables in the same instance,
# but a dedicated DB keeps the migration ownership cleaner.
DATABASE_URL=postgres://wf:wf@localhost:5432/waveflow_auth

# Max size of the in-process Postgres pool (defaults to 10 when unset).
# Bump if you deploy without a pgbouncer / RDS proxy in front.
# BETTER_AUTH_DB_MAX=10

# 32-byte random secret Better Auth uses to sign session cookies +
# JWTs. Generate with:
#   openssl rand -base64 32
# Rotating this invalidates every existing session.
BETTER_AUTH_SECRET=replace-me-with-openssl-rand-base64-32-output

# Public-facing origin of this Nitro instance. Better Auth uses it
# for the JWT `iss` claim and for OAuth redirect URLs. Must match
# the URL the browser hits (incl. scheme + port).
BETTER_AUTH_URL=http://localhost:3000

# Audience claim stamped into every JWT issued by the `jwt()` plugin.
# Defaults to `waveflow-server` so the verifier on the Rust side has
# a stable string to check `aud` against. Override when multiple
# backend instances share this auth server (e.g.
# `waveflow-server-eu` / `waveflow-server-us`).
# WAVEFLOW_JWT_AUDIENCE=waveflow-server

# Base URL of the waveflow-server Rust backend. Server-side TanStack
# server functions mint a JWT off the user's Better Auth session and
# forward requests here with `Authorization: Bearer <jwt>` — so the
# browser never sees this URL and we sidestep CORS. Dev convention:
# run waveflow-server on :4000 (`WAVEFLOW_BIND=127.0.0.1:4000 cargo
# run`) so it doesn't collide with this Nitro instance on :3000.
WAVEFLOW_SERVER_URL=http://localhost:4000

# ─────────────────────────────────────────────────────────────────
# OAuth providers (Sprint 2). Each provider is opt-in — leave the
# pair below empty to hide its sign-in button. Better Auth checks
# both id + secret are present before registering the endpoint, so
# a half-configured deploy (id set, secret missing) refuses to
# advertise the provider rather than 500-ing at first click.
#
# Redirect URI both providers must allow:
#   ${BETTER_AUTH_URL}/api/auth/callback/<provider>
# (e.g. http://localhost:3000/api/auth/callback/google for dev)
# ─────────────────────────────────────────────────────────────────

# Google OAuth (Google Cloud Console → APIs & Services → Credentials
# → Create OAuth client ID, type "Web application").
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Apple Sign In with Apple (developer.apple.com → Certificates,
# Identifiers & Profiles → Services IDs).
#
# `APPLE_CLIENT_ID` is the Services ID (e.g. `com.example.web`).
# `APPLE_CLIENT_SECRET` is a JWT signed with the team's AuthKey p8 —
# Apple does NOT vend a plain secret. Recipe (operator side):
#
#   1. Download the .p8 key from "Keys" in the Apple Developer
#      portal. Note its 10-char Key ID and your 10-char Team ID.
#   2. Use any JWT lib (or `step crypto jwt sign` from smallstep) to
#      mint an ES256 JWT with:
#        header  = { alg: "ES256", kid: <KEY_ID> }
#        payload = { iss: <TEAM_ID>, nbf: now, iat: now,
#                    exp: now + 15777000 (≈6 mo),
#                    aud: "https://appleid.apple.com",
#                    sub: <APPLE_CLIENT_ID> }
#      signed by the p8 private key. `nbf` (not-before) is optional
#      per Apple's spec but recommended — pins the moment the token
#      becomes valid so a clock-skewed verifier can't accept it
#      before mint. Apple's max lifetime is 6 months — set a
#      calendar reminder to rotate.
#   3. The resulting JWT string goes here as `APPLE_CLIENT_SECRET`.
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=
