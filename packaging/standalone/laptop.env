# WaveFlow Server: settings for this computer
#
# This file sits beside the server and is read every time it starts. It turns
# on laptop mode, which keeps your music data in this computer's application
# folder and lets only this computer reach the server.
#
# A line starting with # is ignored. To change a setting below, remove the #
# at the start of its line, edit the value, save the file, then close the
# server's window and start the server again.

WAVEFLOW_LAPTOP=true

# --- Port -------------------------------------------------------------------
#
# The server listens on port 4533 of this computer only. If another program
# already uses that port, the server says so when it starts: choose another
# port with this line.
#
# WAVEFLOW_BIND=127.0.0.1:4534

# --- Your phone and other devices --------------------------------------------
#
# To let a phone, a tablet or another computer on the same network use the
# server, use this line instead of the one above. The server then prints the
# address to type on the other device. Windows asks once whether to allow it
# through the firewall. Anyone on that network can then reach the sign-in
# page, so use it on a network you trust, such as your home Wi-Fi.
#
# WAVEFLOW_BIND=0.0.0.0:4533

# --- Data folder --------------------------------------------------------------
#
# Where the database, the encryption key, the covers and the cache are kept.
# By default:
#   Windows  %LOCALAPPDATA%\WaveFlow Server
#   macOS    ~/Library/Application Support/WaveFlow Server
#   Linux    ~/.local/share/waveflow-server
# To keep them elsewhere, write the full path of a folder after the = sign,
# between single quotes: without them, a backslash or a space stops the server
# from starting. Moving the data later means moving that whole folder: the
# database and the key inside it only work together.
#
# WAVEFLOW_DATA_DIR='D:\Music Data\WaveFlow Server'
# WAVEFLOW_DATA_DIR='/Users/ada/Music Data/WaveFlow Server'

# --- Cache ------------------------------------------------------------------
#
# How much disk space, in bytes, converted copies of your songs may use.
# 2 GiB by default; the oldest copies are removed first.
#
# WAVEFLOW_TRANSCODE_CACHE_MAX_BYTES=2147483648
