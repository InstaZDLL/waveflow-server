# Env exclusion that catches `.env`, `.env.local`, `.env.production`,
# `.env.staging`, etc. without silently swallowing `.envrc` (a
# standard direnv file that a future contributor might add). The
# `!.env.example` negation keeps the committed template (used by
# `.env.example → .env` bootstrap) reachable.
.env
.env.*
!.env.example
.nitro
.tanstack
.wrangler
.output
.vinxi
__unconfig*
todos.json

# Generated by `@tanstack/router-plugin` on each Vite build / dev
# tick. Lives in source-shape so editor go-to-def works, but is
# never committed — a stale checked-in copy would silently drift
# from `src/routes/`.
src/routeTree.gen.ts
