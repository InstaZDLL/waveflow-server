{
  "name": "waveflow-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "WaveFlow web client — React + TanStack Start frontend for waveflow-server",
  "license": "AGPL-3.0-only",
  "homepage": "https://waveflow.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/InstaZDLL/waveflow-server.git",
    "directory": "web"
  },
  "bugs": "https://github.com/InstaZDLL/waveflow-server/issues",
  "imports": {
    "#/*": "./src/*"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "db:migrate": "bun run scripts/db-migrate.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@better-auth/core": "1.6.25",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/router-plugin": "^1.132.0",
    "@waveflow/design-tokens": "workspace:*",
    "better-auth": "1.6.25",
    "kysely": "~0.28.17",
    "lucide-react": "^1.17.0",
    "nitro": "npm:nitro-nightly@latest",
    "pg": "^8.21.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.22",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^10",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "latest",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "prettier": "^3.4.2",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.20.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
