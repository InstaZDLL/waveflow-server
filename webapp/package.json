{
  "name": "waveflow-webapp",
  "private": true,
  "version": "0.0.0",
  "description": "Embedded WaveFlow Server v2 web client. Built to webapp/dist and compiled into the server binary.",
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p e2e",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:e2e": "tsc --noEmit -p e2e",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5",
    "@fontsource/playfair-display": "5",
    "@noble/hashes": "2.4.0",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.46",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.6.2",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.31",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
