{
  "name": "waveflow-webapp",
  "private": true,
  "version": "0.0.0",
  "description": "Embedded WaveFlow Server v2 web client. Built to webapp/dist and compiled into the server binary.",
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.95.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.10"
  }
}
