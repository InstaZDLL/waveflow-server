# Build artifacts
target/

# Cargo-generated lockfile lives in tree (we ship a binary, not a library).
# Local environment overrides
.env
.env.local

# Root package.json's only runtime dep is `concurrently` (dev tooling
# orchestrator). Lockfile stays committed at the root; node_modules
# is regenerated on `bun install`.
node_modules/

# IDE / OS noise
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# AI related files
.agents/*
.claude/*
.mcp.json
skills-lock.json
.codex
webapp/dist/
webapp/playwright-report/
webapp/test-results/

# The server writes here at runtime: the SQLite database, the instance key
# that decrypts what the database holds encrypted, the artwork cache and the
# transcode cache. Never tracked. A `git add -A` from the repository root swept
# the whole directory into a commit once, key included, on a public remote.
data/
